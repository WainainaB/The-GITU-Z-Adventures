<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The GITU'Z Adventures | Kanunga Waterfalls</title>
    <style>
        :root {
            --brand-dark: #1a1a1a;
            --brand-accent: #f1c40f; /* Match the yellow price highlight */
            --text-main: #333;
            --white: #ffffff;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Arial Black', Gadget, sans-serif; }
        body { line-height: 1.6; color: var(--text-main); background-color: #fff; }
        
        /* Nav */
        nav { 
            background: var(--white); 
            padding: 10px 5%; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            position: fixed; 
            width: 100%; 
            top: 0; 
            z-index: 1000;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        .logo-container { display: flex; align-items: center; }
        .logo-placeholder { width: 50px; height: 50px; border: 2px solid var(--brand-dark); display: flex; align-items: center; justify-content: center; margin-right: 10px; font-size: 0.6rem; text-align: center; }

        /* Hero Section */
        .hero { 
            height: 80vh; 
            background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url('https://images.unsplash.com/photo-1441974231531-c6227db76b6e?auto=format&fit=crop&w=1920&q=80'); 
            background-size: cover; 
            background-position: center; 
            display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; color: #fff;
        }
        .hero h1 { font-size: 4rem; text-transform: uppercase; line-height: 1; }
        .hero .location { color: var(--brand-accent); font-size: 1.5rem; margin-top: 10px; }

        /* Event Section */
        .event-detail { padding: 60px 10%; display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
        .event-image img { width: 100%; border-radius: 5px; box-shadow: 10px 10px 0px var(--brand-dark); }
        
        .price-tag { 
            background: var(--brand-accent); 
            color: #000; 
            display: inline-block; 
            padding: 10px 30px; 
            font-size: 2rem; 
            font-weight: bold; 
            margin: 20px 0;
            transform: skew(-10deg);
        }

        .inclusions { list-style: none; margin-top: 20px; }
        .inclusions li { margin-bottom: 10px; font-size: 1.2rem; display: flex; align-items: center; }
        .inclusions li::before { content: '●'; color: var(--brand-accent); margin-right: 15px; font-size: 1.5rem; }

        /* Booking Section */
        .booking { background: var(--brand-dark); color: #fff; padding: 60px 10%; text-align: center; }
        .btn-book { 
            background: var(--brand-accent); 
            color: #000; 
            padding: 20px 50px; 
            text-decoration: none; 
            font-size: 1.5rem; 
            display: inline-block; 
            margin-top: 30px;
            transition: 0.3s;
        }
        .btn-book:hover { transform: scale(1.05); background: #fff; }

        @media (max-width: 768px) {
            .event-detail { grid-template-columns: 1fr; }
            .hero h1 { font-size: 2.5rem; }
        }
    </style>
</head>
<body>

    <nav>
        <div class="logo-container">
            <div class="logo-placeholder">LOGO<br>HERE</div>
            <span>THE GITU'Z ADVENTURES</span>
        </div>
    </nav>

    <section class="hero">
        <h1>Kanunga Waterfalls</h1>
        <div class="location">MURANG'A, KENYA</div>
    </section>

    <section class="event-detail">
        <div class="event-image">
            <img src="https://images.unsplash.com/photo-1518495973542-4542c06a5843?auto=format&fit=crop&w=800&q=80" alt="Waterfall">
        </div>
        <div class="info">
            <h2>UPCOMING EXPEDITION</h2>
            <div class="price-tag">PRICE 3000</div>
            <h3>Inclusive of:</h3>
            <ul class="inclusions">
                <li>Transport</li>
                <li>Food</li>
                <li>Entrance fee</li>
                <li>Hiking</li>
                <li>Swimming</li>
                <li>Drinks</li>
                <li>Snacks</li>
            </ul>
        </div>
    </section>

    <section class="booking">
        <h2>READY FOR THE THRILL?</h2>
        <p>Space is limited for this Murang'a expedition. Secure your spot now.</p>
        <a href="#" class="btn-book">BOOK YOUR SPOT</a>
    </section>

    <footer style="text-align: center; padding: 20px; font-size: 0.8rem; color: #999;">
        &copy; 2026 THE GITU'Z ADVENTURES. ALL RIGHTS RESERVED.
    </footer>

</body>
</html>
